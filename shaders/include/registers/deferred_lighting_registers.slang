#ifndef DEFERRED_LIGHTING_REGISTERS_H
#define DEFERRED_LIGHTING_REGISTERS_H

#include "common/system/sys_constants.slang"
#include "common/common_lighting.slang"


[vk::binding(0, DESC_SET_PER_DRAW)] ConstantBuffer<GPU_LightingData> DEFERRED_LIGHTING_DATA;

[vk::binding(1, DESC_SET_PER_DRAW)] Texture2D DEFERRED_LIGHTING_GBUFFER_0;
[vk::binding(2, DESC_SET_PER_DRAW)] Texture2D DEFERRED_LIGHTING_GBUFFER_1;
[vk::binding(3, DESC_SET_PER_DRAW)] Texture2D DEFERRED_LIGHTING_GBUFFER_2;
[vk::binding(4, DESC_SET_PER_DRAW)] Texture2D DEFERRED_LIGHTING_GBUFFER_3;

[vk::binding(5, DESC_SET_PER_DRAW)] Texture2D DEFERRED_LIGHTING_DEPTH;

[vk::binding(6, DESC_SET_PER_DRAW)] TextureCube DEFERRED_LIGHTING_IRRADIANCE_MAP;
[vk::binding(7, DESC_SET_PER_DRAW)] TextureCube DEFERRED_LIGHTING_PREFILTERED_ENV_MAP;
[vk::binding(8, DESC_SET_PER_DRAW)] Texture2D   DEFERRED_LIGHTING_BRDF_LUT;

[vk::binding(9, DESC_SET_PER_DRAW)] Texture2DArray DEFERRED_LIGHTING_CSM;


#define DEFERRED_LIGHTING_CSM_DATA                                       DEFERRED_LIGHTING_DATA.csmData
#define DEFERRED_LIGHTING_CSM_RT_SIZE                                    DEFERRED_LIGHTING_CSM_DATA.rtSize
#define DEFERRED_LIGHTING_CSM_INV_RT_SIZE                                (ONEF2 / DEFERRED_LIGHTING_CSM_RT_SIZE)
#define DEFERRED_LIGHTING_CSM_CASCADE_DATA(CASCADE_IDX)                  DEFERRED_LIGHTING_CSM_DATA.cascades[CASCADE_IDX]
#define DEFERRED_LIGHTING_CSM_CASCADE_VIEW_PROJ_MATR(CASCADE_IDX)        DEFERRED_LIGHTING_CSM_CASCADE_DATA(CASCADE_IDX).viewProjMatr
#define DEFERRED_LIGHTING_CSM_CASCADE_DISTANCE(CASCADE_IDX)              DEFERRED_LIGHTING_CSM_CASCADE_DATA(CASCADE_IDX).distance
#define DEFERRED_LIGHTING_CSM_CASCADE_Z_NEAR(CASCADE_IDX)                DEFERRED_LIGHTING_CSM_CASCADE_DATA(CASCADE_IDX).zNear
#define DEFERRED_LIGHTING_CSM_CASCADE_Z_FAR(CASCADE_IDX)                 DEFERRED_LIGHTING_CSM_CASCADE_DATA(CASCADE_IDX).zFar
#define DEFERRED_LIGHTING_CSM_CASCADE_WORLD_UNITS_PER_PIXEL(CASCADE_IDX) DEFERRED_LIGHTING_CSM_CASCADE_DATA(CASCADE_IDX).worldUnitsPerPixel

#define DEFERRED_LIGHTING_CSM_PCSS_DATA DEFERRED_LIGHTING_CSM_DATA.pcssData
#define DEFERRED_LIGHTING_SUN_DATA      DEFERRED_LIGHTING_DATA.sunData

#endif